 "mothman": {"name": "???", "kind": "anomaly", "level": 6, "composure": 999, "attack": [10, 14], "speed": 9, "xp": 60, "weak": [], "resist": ["physical"], "turns": 8, "phases": 3,
  "moves": [{"name": "Red glare", "type": "horror", "power": [8, 12], "text": "Two red lights open at the top of the stairs. They are eyes, or they want you to think so."}, {"name": "Shriek", "type": "all", "damage": "spirit", "power": [5, 8], "text": "A shriek like a loose fan belt the size of a barn."}, {"name": "Wings open", "type": "horror", "power": [11, 15], "text": "The dark gets wider."}],
