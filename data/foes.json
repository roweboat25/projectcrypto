  "moves": [{"name": "All colours", "type": "horror", "power": [6, 9], "text": "The coat is every colour, and then it is one colour, and then it is every colour again."}, {"name": "The hat turns", "type": "horror", "power": [5, 8], "text": "The pointed hat turns toward you before the head does."}, "A shove"],
